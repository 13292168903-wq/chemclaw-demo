# ChemClaw 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# DeepSeek API（推荐，国内可用）
DEEPSEEK_API_KEY=你的key
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API（备选）
# OPENAI_API_KEY=你的key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com

# ===== OpenClaw（可选，接入后走 Agent 链路）=====
# 先装 CLI 和技能：npm install -g openclaw && npm run install:skills
# 指定单次调用使用的模型；不填则用 OpenClaw 的全局默认模型
# CHEMCLAW_OPENCLAW_MODEL=deepseek/deepseek-v4-flash
# 手动指定 CLI 入口（Windows 下一般不用，程序会自动解析 npm 生成的 .cmd）
# CHEMCLAW_OPENCLAW_BIN=C:\Users\you\AppData\Roaming\npm\node_modules\openclaw\openclaw.mjs
